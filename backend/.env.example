# Local development. Use Google Cloud Secret Manager for production secrets.

# Required.
OPENAI_API_KEY=your_openai_api_key

# Required. Use a random secret with at least 32 characters.
RETRY_TOKEN_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Optional. Default model.
OPENAI_MODEL=gpt-6.1-terra
